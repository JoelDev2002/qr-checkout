generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  CASHIER
  ADMIN
}

enum CartStatus {
  OPEN
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  CMR_CARD
  OTHER_CARD
  CASH
  ONLINE
}

enum PriceType {
  NORMAL
  CMR
}

enum DocType {
  TICKET
  BOLETA
  FACTURA
}

enum FieldType {
  TEXT
  NUMBER
  SELECT
  BOOLEAN
}

enum DiscountType {
  PERCENT
  FIXED
}

enum CampaignScope {
  PRODUCTS
  CATEGORIES
  STORE
}

enum PaymentAttemptStatus {
  CREATED
  FAILED
  APPROVED
  SALE_CREATED
  REFUNDED
  REFUND_FAILED
  UNKNOWN
}

enum PurchaseOrderStatus {
  REGISTERED
  APPROVED
  RECEIVED
  CANCELLED
}

enum GoodsIssueReason {
  TRANSFER
  SUPPLIER_RETURN
  SHRINKAGE
}

enum InventoryCountStatus {
  OPEN
  CLOSED
}

enum BackupType {
  BACKUP
  RESTORE
}

enum BackupStatus {
  SUCCESS
  FAILED
}

model User {
  id            Int               @id @default(autoincrement())
  email         String            @unique
  name          String
  role          Role
  googleId      String?           @unique
  passwordHash  String?
  active        Boolean           @default(true)
  createdAt     DateTime          @default(now())
  carts         Cart[]
  cashierSales  Sale[]            @relation("CashierSales")
  customerSales Sale[]            @relation("CustomerSales")
  adjustments   StockAdjustment[]
  scans         ProductScan[]
  paymentAttempts PaymentAttempt[]
  purchaseOrdersCreated  PurchaseOrder[]  @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved PurchaseOrder[]  @relation("PurchaseOrderApprovedBy")
  goodsReceipts          GoodsReceipt[]
  goodsIssues            GoodsIssue[]
  inventoryCounts        InventoryCount[]
  backupRecords          BackupRecord[]
}

model Category {
  id        Int                @id @default(autoincrement())
  name      String             @unique
  active    Boolean            @default(true)
  fields    CategoryField[]
  products  Product[]
  campaigns CampaignCategory[]
}

model CategoryField {
  id         Int       @id @default(autoincrement())
  categoryId Int
  category   Category  @relation(fields: [categoryId], references: [id])
  key        String // identificador estable, no cambia después de crearse
  label      String // texto visible en formularios y en la app del cliente
  type       FieldType // tampoco cambia después de crearse
  required   Boolean   @default(false)
  options    Json? // lista de textos, solo si type = SELECT
  unit       String? // por ejemplo "horas", solo si type = NUMBER
  sortOrder  Int       @default(0)
  active     Boolean   @default(true)

  @@unique([categoryId, key])
}

model Campaign {
  id            Int                @id @default(autoincrement())
  name          String
  scope         CampaignScope
  discountType  DiscountType
  discountValue Int // PERCENT: puntos básicos · FIXED: céntimos por unidad
  priority      Int                @default(0) // mayor gana
  startsAt      DateTime
  endsAt        DateTime
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  products      CampaignProduct[] // se usa si scope = PRODUCTS
  categories    CampaignCategory[] // se usa si scope = CATEGORIES
}

model CampaignProduct {
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])

  @@id([campaignId, productId])
}

model CampaignCategory {
  campaignId Int
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([campaignId, categoryId])
}

model Product {
  id                 Int               @id @default(autoincrement())
  barcode            String            @unique
  name               String
  brand              String
  color              String?
  categoryId         Int
  category           Category          @relation(fields: [categoryId], references: [id])
  originalPriceCents Int
  hasCmrDiscount     Boolean           @default(false)
  cmrDiscountBps     Int               @default(0)
  attributes         Json? // valores de los campos de su categoría, por key
  campaigns          CampaignProduct[]
  stock              Int               @default(0)
  minStock           Int               @default(5) // bajo este stock se sugiere reponer (órdenes de compra)
  maxPerPurchase     Int               @default(10)
  imageUrl           String?
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  cartItems          CartItem[]
  saleItems          SaleItem[]
  adjustments        StockAdjustment[]
  scans              ProductScan[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems  GoodsReceiptItem[]
  goodsIssueItems    GoodsIssueItem[]
  inventoryItems     InventoryCountItem[]
}

model StockAdjustment {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  delta     Int
  reason    String
  createdAt DateTime @default(now())
}

model Cart {
  id          Int        @id @default(autoincrement())
  customerId  Int
  customer    User       @relation(fields: [customerId], references: [id])
  status      CartStatus @default(OPEN)
  qrCode      String?    @unique
  qrExpiresAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       CartItem[]
  sale        Sale?
  paymentAttempts PaymentAttempt[]
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([cartId, productId])
}

model Sale {
  id                 Int           @id @default(autoincrement())
  code               String        @unique // el código del carrito (caja) u O-XXXXX (en línea)
  receiptNumber      String        @unique // T001-000001, B001-000001, F001-000001
  cartId             Int           @unique
  cart               Cart          @relation(fields: [cartId], references: [id])
  customerId         Int
  customer           User          @relation("CustomerSales", fields: [customerId], references: [id])
  cashierId          Int? // nulo si fue pago en línea
  cashier            User?         @relation("CashierSales", fields: [cashierId], references: [id])
  paymentMethod      PaymentMethod
  priceApplied       PriceType
  originalTotalCents Int // suma de precios originales
  offerTotalCents    Int // total con campañas, sin CMR
  cmrTotalCents      Int // total con CMR
  totalCents         Int // lo realmente cobrado
  docType            DocType       @default(TICKET)
  buyerDocType       String?
  buyerDocNumber     String?
  buyerName          String?
  buyerEmail         String?
  cardBrand          String? // solo pagos en línea
  cardLast4          String?
  cardIssuer         String?
  mpPaymentId        String?
  deliveredAt        DateTime?
  createdAt          DateTime      @default(now())
  items              SaleItem[]
}

model SaleItem {
  id                 Int     @id @default(autoincrement())
  saleId             Int
  sale               Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId          Int
  product            Product @relation(fields: [productId], references: [id])
  barcode            String
  name               String
  quantity           Int
  originalPriceCents Int
  normalPriceCents   Int
  cmrPriceCents      Int
  paidPriceCents     Int // precio unitario realmente cobrado
  subtotalCents      Int // paidPriceCents × cantidad
  campaignName       String?
}

model PaymentAttempt {
  id                Int                  @id @default(autoincrement())
  tokenHash         String               @unique // SHA-256 del token de Mercado Pago; nunca el token en claro
  cartId            Int
  cart              Cart                 @relation(fields: [cartId], references: [id])
  customerId        Int
  customer          User                 @relation(fields: [customerId], references: [id])
  amountCents       Int
  status            PaymentAttemptStatus @default(CREATED)
  mpOrderId         String?
  externalReference String               @unique // derivado del attemptId: mayúsculas alfanuméricas, sin guiones
  failureCode       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model DocumentSeries {
  series     String @id // T001, B001, F001
  lastNumber Int    @default(0)
}

/** Cada lectura exitosa del escáner del cliente registra una fila (T3.1: "más escaneados"). */
model ProductScan {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  customerId Int
  customer   User     @relation(fields: [customerId], references: [id])
  createdAt  DateTime @default(now())

  @@index([productId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Compras y almacén (épicas Gestionar compras y Gestionar almacén).
// Los números correlativos (OC01-000001, GE01-000001, GS01-000001, IN01-000001)
// se asignan con DocumentSeries, igual que los comprobantes de venta.
// ---------------------------------------------------------------------------

/** Proveedor de la tienda. No se borra: se desactiva. */
model Supplier {
  id             Int             @id @default(autoincrement())
  ruc            String          @unique @db.Char(11)
  businessName   String
  contactName    String?
  phone          String?
  email          String?
  address        String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

/** Orden de compra a un proveedor. El total lo calcula el servidor. */
model PurchaseOrder {
  id           Int                 @id @default(autoincrement())
  number       String              @unique // OC01-000001
  supplierId   Int
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       PurchaseOrderStatus @default(REGISTERED)
  totalCents   Int
  notes        String?
  createdById  Int
  createdBy    User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  approvedById Int?
  approvedBy   User?               @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]
  receipts     GoodsReceipt[]

  @@index([supplierId, createdAt])
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCostCents   Int
  subtotalCents   Int // unitCostCents × quantity

  @@unique([purchaseOrderId, productId])
}

/** Guía de entrada: mercadería recibida de una orden de compra aprobada. Suma al stock. */
model GoodsReceipt {
  id              Int                @id @default(autoincrement())
  number          String             @unique // GE01-000001
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  userId          Int
  user            User               @relation(fields: [userId], references: [id])
  notes           String?
  createdAt       DateTime           @default(now())
  items           GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id             Int          @id @default(autoincrement())
  goodsReceiptId Int
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product      @relation(fields: [productId], references: [id])
  quantity       Int

  @@unique([goodsReceiptId, productId])
}

/** Guía de salida: mercadería que sale sin venta. Resta del stock y nunca lo deja negativo. */
model GoodsIssue {
  id        Int              @id @default(autoincrement())
  number    String           @unique // GS01-000001
  reason    GoodsIssueReason
  notes     String?
  userId    Int
  user      User             @relation(fields: [userId], references: [id])
  createdAt DateTime         @default(now())
  items     GoodsIssueItem[]
}

model GoodsIssueItem {
  id           Int        @id @default(autoincrement())
  goodsIssueId Int
  goodsIssue   GoodsIssue @relation(fields: [goodsIssueId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int

  @@unique([goodsIssueId, productId])
}

/** Inventario físico: al cerrarlo, cada diferencia genera un StockAdjustment con motivo. */
model InventoryCount {
  id          Int                  @id @default(autoincrement())
  number      String               @unique // IN01-000001
  status      InventoryCountStatus @default(OPEN)
  notes       String?
  createdById Int
  createdBy   User                 @relation(fields: [createdById], references: [id])
  closedAt    DateTime?
  createdAt   DateTime             @default(now())
  items       InventoryCountItem[]
}

model InventoryCountItem {
  id               Int            @id @default(autoincrement())
  inventoryCountId Int
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product        @relation(fields: [productId], references: [id])
  systemStock      Int // stock del sistema al momento del conteo
  countedStock     Int
  difference       Int // countedStock − systemStock

  @@unique([inventoryCountId, productId])
}

/** Registro de cada backup y restauración de la base de datos (épica Gestionar seguridad). */
model BackupRecord {
  id        Int          @id @default(autoincrement())
  type      BackupType
  fileName  String
  sizeBytes Int?
  status    BackupStatus
  detail    String?
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  createdAt DateTime     @default(now())
}